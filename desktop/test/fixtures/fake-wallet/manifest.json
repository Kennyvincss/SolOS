{
  "manifest_version": 3,
  "name": "Fake Wallet (test)",
  "version": "1.0.0",
  "action": { "default_title": "Fake Wallet", "default_popup": "popup.html", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "world": "MAIN" }],
  "permissions": ["storage"]
}
