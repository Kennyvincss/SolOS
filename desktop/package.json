{
  "name": "solana-os-desktop",
  "productName": "STRATA",
  "version": "0.2.0",
  "description": "STRATA desktop browser with Chrome wallet extensions (Phantom, Solflare, Backpack).",
  "main": "src/main.js",
  "license": "GPL-3.0-only",
  "author": "STRATA",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "app.solanaos.desktop",
    "productName": "STRATA",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "!src/**/*.test.js"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "maintainer": "Kennyvincss <Kennyvincss@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "strata-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Kennyvincss",
        "repo": "SolOS",
        "tagNamePrefix": "desktop-v",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "STRATA",
        "schemes": [
          "solanaos-desktop"
        ]
      }
    ],
    "appx": {
      "identityName": "STRATABROWSER.STRATABROWSER",
      "publisher": "CN=19C0BA52-3A13-4D31-A5F8-C62567A54B84",
      "publisherDisplayName": "STRATA BROWSER",
      "displayName": "STRATA BROWSER",
      "applicationId": "STRATA",
      "backgroundColor": "#07070b",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": false
    }
  },
  "dependencies": {
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@scure/bip39": "^2.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kennyvincss/SolOS.git"
  },
  "desktopName": "solana-os.desktop"
}
