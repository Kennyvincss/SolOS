# Solana OS configuration. Every variable is optional for local development.
# On Vercel: Project → Settings → Environment Variables.

# --- Required in production -------------------------------------------------
# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# --- Data -------------------------------------------------------------------
# auto = live providers, falling back to clearly labelled demo data on failure
# live = never fall back (errors surface in the UI)
# demo = never call upstream providers
DATA_MODE=auto

# Solana RPC. The public endpoint is rate limited; use Helius, Triton, QuickNode…
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter (tokens, prices). With a key, point this at https://api.jup.ag
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# Optional overrides
# GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
# DEFILLAMA_API_URL=https://api.llama.fi
# DEFILLAMA_YIELDS_URL=https://yields.llama.fi

# News feeds as "Name|URL" pairs, comma separated
# NEWS_FEEDS=Solana|https://solana.com/news/rss.xml,Decrypt|https://decrypt.co/feed

# --- Web search -----------------------------------------------------------------
# Search shows results from the whole web (Solana results first). Without a key
# it uses DuckDuckGo and Wikipedia; with a Brave Search key (free tier:
# https://brave.com/search/api/) results are more reliable.
# BRAVE_SEARCH_API_KEY=

# --- Solana AI (Groq) --------------------------------------------------------
# Free API key from https://console.groq.com/keys
# Without a key, Solana AI runs in offline mode (templated answers over live data).
GROQ_API_KEY=
# Optional. Leave unset to auto-select a tool-capable model your key can use.
# To pin one, pick from https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b

# --- Sign-in ------------------------------------------------------------------
# Public URL, used for OAuth redirects and email links. On Vercel this defaults
# to the production domain.
# APP_URL=https://your-domain.com

# Google OAuth: redirect URI = ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email magic links via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Solana OS <login@your-domain.com>

# --- Account sync --------------------------------------------------------------
# Syncs signed-in users' watchlist, follows, alerts, extensions and settings
# (website) and bookmarks/settings (desktop app). Add the Upstash Redis
# integration in Vercel (Storage tab) and these are set automatically.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
